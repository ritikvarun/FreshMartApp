# ─────────────────────────────────────────────────────────────
# FRESHMART BACKEND CONFIGURATION (.env)
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_STRICT=false

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL=your_mongodb_connection_string
MONGODB_URI=your_mongodb_connection_string

# JWT Secret (Used for authenticating customer and admin tokens)
JWT_SECRET=your_jwt_secret_key_here

# Admin Login Credentials (Used to login on admin-mobile app)
ADMIN_EMAIL=admin@freshmart.com
ADMIN_PASSWORD=YourSecureAdminPassword123

# Cloudinary Configuration (For uploading product images and banners)
# Get from: https://cloudinary.com -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Configuration (For order confirmation & customer emails)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_USER=onboarding@resend.dev

# Razorpay Online Payments (Optional: For online credit card / UPI checkout)
# Get from: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
