# ─────────────────────────────────────────────────────────────
# ADMIN MOBILE APP ENVIRONMENT CONFIGURATION (.env)
# ─────────────────────────────────────────────────────────────

# Backend API Base URL
# - For local development on physical device: http://<YOUR_WIFI_IP>:5000 (e.g. http://192.168.1.5:5000)
# - For Android Emulator: http://10.0.2.2:5000
# - For Deployed Production Backend (e.g. Render): https://your-backend-app.onrender.com
EXPO_PUBLIC_API_URL=https://your-backend-app.onrender.com
